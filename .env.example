# Copy this file to .env and fill in your real values.
#
# This agent works with any OpenAI-compatible API. Pick ONE provider:
#
# --- Option A: OpenAI (paid) -------------------------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
#
# --- Option B: Groq (free, recommended) --------------------------------------
# Sign up at https://console.groq.com → API Keys → Create
# OPENAI_API_KEY=gsk_...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile
#
# --- Option C: OpenRouter (free models available) ----------------------------
# OPENAI_API_KEY=sk-or-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct:free
# -----------------------------------------------------------------------------

OPENAI_API_KEY=your-key-here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile

# Hard cap on tool-calling iterations before the agent gives up
AGENT_MAX_STEPS=10
